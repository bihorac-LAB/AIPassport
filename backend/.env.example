# ─── Core ──────────────────────────────────────────────────────────────────────
# development | test | staging | production
ENVIRONMENT=development

# Random, at least 32 characters. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# A DIFFERENT random value. Used to hash IPs and email log tags; rotating SECRET_KEY alone then
# does not invalidate stored hashes.
HASH_SALT=

# Serve /docs in production (default: off in production/staging)
# ENABLE_DOCS=false

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL must stay on localhost/private networking. Never open port 5432 publicly.
DATABASE_URL=postgresql+asyncpg://aipassport:CHANGE_ME@localhost:5432/aipassport
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ─── Frontend / CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Explicit allowlist, comma separated. No wildcards in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Tokens & cookies ─────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFY_EXPIRE_HOURS=48
# In production the SPA is cross-site (Netlify -> EC2) and may run in a Canvas iframe,
# so use: COOKIE_SAMESITE=none and COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.edu

# ─── LLM ──────────────────────────────────────────────────────────────────────
# auto | openai_compatible | gemini | echo
# "auto" uses the OpenAI-compatible endpoint when LLM_API_KEY is set, else Gemini when
# GEMINI_API_KEY is set, else a deterministic offline stub so the app still runs.
LLM_PROVIDER=auto

# UF NaviGator Toolkit (OpenAI-compatible) — the provider the legacy app used
LLM_BASE_URL=https://api.ai.it.ufl.edu/v1
LLM_MODEL=gemma-3-27b-it
LLM_API_KEY=

# Google Gemini (alternative provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TEMPERATURE=0.5
AI_RATE_LIMIT_PER_HOUR=20
AI_RATE_LIMIT_PER_DAY=200

# ─── SMTP (optional; without it, reset/verify tokens are logged at DEBUG) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=aipassport@example.edu
SMTP_STARTTLS=true

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# JSON logs default to on in production, off in development
# LOG_JSON=true

# ─── Tests ────────────────────────────────────────────────────────────────────
# Used by pytest only. Must be a database you are willing to have truncated.
TEST_DATABASE_URL=postgresql+asyncpg://aipassport:CHANGE_ME@localhost:5432/aipassport_test

# ─── Auth rate limits (defaults are production-appropriate) ───────────────────
# Raise these ONLY in automated test environments, where many registrations and logins
# come from one IP.
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_LOGIN_PER_EMAIL=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
