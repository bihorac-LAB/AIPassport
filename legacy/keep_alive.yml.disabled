name: "Streamlit Keep-Alive"

on:
  schedule:
    # Runs every 6 hours
    - cron: "0 */6 * * *"
  workflow_dispatch:
    # Allows manual trigger for testing

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping Streamlit App
        run: |
          # We remove -L to avoid redirect loops (Error 47). 
          # A simple request is enough to keep the app 'warm' on Streamlit Cloud.
          curl -s --max-time 15 -A "AIPassport-KeepAlive" https://aipassport-uf.streamlit.app/ > /dev/null || true
          echo "Successfully pinged https://aipassport-uf.streamlit.app/ at $(date)"
